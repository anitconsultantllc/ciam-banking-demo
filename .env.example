# Local development settings. Copy to .env (git-ignored) and adjust if a port clashes.
# These are throwaway dev credentials, never used outside docker compose on your machine.

# --- Postgres (one container, one database per service) ---
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_pw
APP_DB_PASSWORD=app_dev_pw

# --- Keycloak ---
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_pw
# Confidential client the Customer Service uses to call the Keycloak Admin API
CUSTOMER_SVC_CLIENT_SECRET=customer-svc-dev-secret
# Password for the seeded test users (alice, bob, sam, ada)
TEST_USER_PASSWORD=Passw0rd!2026

# --- Kafka ---
KAFKA_HOST_PORT=9092

# --- RabbitMQ ---
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_USER=bank
RABBITMQ_PASSWORD=rabbit_dev_pw

# --- Mailpit (fake SMTP + web inbox) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Jaeger (tracing UI + OTLP receiver) ---
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
